# Aiven Cloud PostgreSQL.
# Lấy connection string ở Aiven Console → Service → Connect.
# Bắt buộc có ?sslmode=require — Aiven chỉ nhận kết nối có mã hoá TLS.
DATABASE_URL="postgresql://USER:PASSWORD@PROJECT-REF.aivencloud.com:PORT/defaultdbname?sslmode=require"

JWT_SECRET="replace-with-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3005

# Cloudinary — Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
